.DS_Store
.superseded/

# Python — uv manages the venv and the lockfile; the lockfile IS committed.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.complexipy_cache/

# Review reports are working notes, not artifacts.
.reviews/

node_modules/
.env
.dev.vars

# Batches and answers may contain real client data. They live in ~/.guide/,
# outside every working tree, so this is belt-and-braces. Examples are
# synthetic and tracked.
.guide/
*.batch.json
*.answers.json
!examples/*.batch.json
!examples/*.answers.json
